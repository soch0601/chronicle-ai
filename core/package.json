{
  "name": "@chronicle-ai/core",
  "version": "1.1.0",
  "description": "The Enterprise Statechart Engine for AI Agents. A hardened, schema-driven orchestration layer built on LangGraph.js.",
  "author": "Chris (https://github.com/soch0601)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soch0601/chronicle-ai.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/soch0601/chronicle-ai/issues"
  },
  "homepage": "https://github.com/soch0601/chronicle-ai/tree/main/packages/core#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@langchain/core": "^1.1.30",
    "@langchain/langgraph": "^1.2.0",
    "@wasmer/sdk": "^0.10.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "shipit": "dotenv -- npm publish --no-workspaces",
    "test:unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js tests/ --config ../../jest.config.cjs --testPathIgnorePatterns=tests/integration/",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js tests/integration/ --config ../../jest.config.cjs",
    "validate-workflow": "ts-node src/cli/validate.ts"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "statecharts",
    "state-machine",
    "langgraph",
    "langgraph-js",
    "orchestration",
    "llm",
    "enterprise",
    "multi-agent",
    "agentic-workflows",
    "llm-orchestration",
    "deterministic-ai",
    "circuit-breakers",
    "human-in-the-loop",
    "cognitive-architectures"
  ]
